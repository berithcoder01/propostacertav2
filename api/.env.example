# Supabase PostgreSQL
# Obtenha em: Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Para migrações Prisma (pooler não suporta ALTER TABLE)
# Use a connection string direta (porta 5432)
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT — troque em produção
JWT_SECRET="troque-este-segredo-em-producao"

# Google Gemini AI (opcional)
GOOGLE_API_KEY=""

# LeadsOn API (para sincronização de leads)
LEADSON_API_URL="http://localhost:3001"

# URL do frontend (para CORS e callbacks)
FRONTEND_URL="http://localhost:5173"
