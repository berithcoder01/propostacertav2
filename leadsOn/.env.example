# Conexão com o Banco de Dados (Supabase/Neon)
# Use a mesma string do PropostaCerta
DATABASE_URL="postgresql://..."

# ID da Empresa no PropostaCerta (UUID)
# Encontre no banco na tabela "Company"
COMPANY_ID="seu-uuid-aqui"

# Configurações do Scraper
HORA_INICIO=0
HORA_FIM=6
CIDADES_ALVO='[{"nome":"Maringá","estado":"PR"}]'
TERMOS_ALVO='["Eletricista", "Pintor", "Construção"]'
DELAY_ENTRE_REQUISICOES_MS=2000
MAX_LEADS_POR_BUSCA=10
